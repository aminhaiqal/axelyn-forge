# Public web/API runtime.
FORGE_ENVIRONMENT=development
FORGE_DATABASE=.state/forge.sqlite3
FORGE_CORS_ORIGINS=http://localhost:4321,http://localhost:8080
FORGE_WEB_PORT=8080
FORGE_STORAGE_PATH=.state/objects
FORGE_STORAGE_ENDPOINT=
FORGE_STORAGE_TOKEN=
FORGE_MAX_RESUME_BYTES=10485760
FORGE_MAX_RESUME_FILES=5
FORGE_RESUME_TEMPLATE=templates/Axelyn_Standard_Resume_v1.docx
FORGE_CONVERTER_ENDPOINT=http://localhost:8100
FORGE_CONVERTER_TIMEOUT_SECONDS=150
FORGE_CONVERTER_CONCURRENCY=1
FORGE_CONVERTER_MAX_DOCX_BYTES=12582912

# Clerk authentication. Pull development values with `clerk env pull`.
PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-your-clerk-publishable-key
CLERK_SECRET_KEY=replace-with-your-clerk-secret-key
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:4321,http://localhost:8080

# OpenRouter API key and optional OpenRouter model IDs for document tailoring.
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-5.4-mini
OPENROUTER_COVER_LETTER_MODEL=openai/gpt-5.4-mini
OPENROUTER_CONTEXT_MODEL=openai/gpt-5.4-nano
OPENROUTER_WEB_MODEL=openai/gpt-5.4-nano
OPENROUTER_HTTP_REFERER=https://forge.axelyn.com
OPENROUTER_APP_NAME=Axelyn Forge
