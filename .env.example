# Discord Developer Portal credentials and private access controls.
DISCORD_BOT_TOKEN=replace-with-your-bot-token
DISCORD_ALLOWED_USER_IDS=replace-with-your-discord-user-id
# Recommended for a private bot; remove this line only for global registration.
DISCORD_GUILD_ID=replace-with-your-test-server-id

# OpenAI project API key and optional model overrides.
OPENAI_API_KEY=replace-with-your-openai-project-key
OPENAI_MODEL=gpt-5.6-terra
OPENAI_CONTEXT_MODEL=gpt-5.6-luna
OPENAI_WEB_MODEL=gpt-5.6-luna

# Container paths backed by the persistent forge-state volume.
FORGE_DATABASE=/state/context.sqlite3
FORGE_OUTPUT_DIR=/state/output
FORGE_MAX_TXT_BYTES=524288
