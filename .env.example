# Public web/API runtime.
FORGE_ENVIRONMENT=development
FORGE_DATABASE=.state/forge.sqlite3
FORGE_CORS_ORIGINS=http://localhost:4321,http://localhost:8080
FORGE_WEB_PORT=8080

# OpenAI project API key and optional model overrides for document tailoring.
OPENAI_API_KEY=replace-with-your-openai-project-key
OPENAI_MODEL=gpt-5.6-terra
OPENAI_COVER_LETTER_MODEL=gpt-5.6-terra
OPENAI_CONTEXT_MODEL=gpt-5.6-luna
OPENAI_WEB_MODEL=gpt-5.6-luna
