---
import { Show, SignInButton, SignUpButton, UserButton } from "@clerk/astro/components";
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Axelyn Forge home">
    <svg aria-hidden="true" viewBox="0 0 38 38" class="brand-mark">
      <path d="M5 3h21l7 7v25H5z" fill="currentColor"></path>
      <path d="M26 3v8h7" fill="none" stroke="var(--color-copper)" stroke-width="3"></path>
      <path d="M11 25h16M14 19h10M17 13h7" fill="none" stroke="white" stroke-width="2.4"></path>
    </svg>
    <span>Axelyn <strong>Forge</strong></span>
  </a>
  <nav aria-label="Primary navigation">
    <a href="#services">Services</a>
    <a href="#process">Process</a>
    <Show when="signed-out">
      <div class="auth-actions">
        <SignInButton asChild>
          <a class="auth-link" href="/sign-in">Sign in</a>
        </SignInButton>
        <SignUpButton asChild>
          <a class="nav-cta" href="/sign-up">Start forging</a>
        </SignUpButton>
      </div>
    </Show>
    <Show when="signed-in">
      <div class="auth-actions">
        <a class="nav-cta" href="/app">Workspace</a>
        <UserButton />
      </div>
    </Show>
  </nav>
</header>
