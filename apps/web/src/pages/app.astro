---
import { UserButton } from "@clerk/astro/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/resume-library.css";

const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? "";
const { isAuthenticated, redirectToSignIn } = Astro.locals.auth();

if (!isAuthenticated) {
  return redirectToSignIn();
}
---

<BaseLayout
  title="Resume library — Axelyn Forge"
  description="Keep private resume versions, review imported content, and render the Axelyn standard in DOCX and PDF."
>
  <div class="library-page" data-api-base={apiBase}>
    <header class="library-header">
      <a class="brand" href="/" aria-label="Axelyn Forge home">
        <svg aria-hidden="true" viewBox="0 0 38 38" class="brand-mark">
          <path d="M5 3h21l7 7v25H5z" fill="currentColor"></path>
          <path d="M26 3v8h7" fill="none" stroke="var(--color-copper)" stroke-width="3"></path>
          <path d="M11 25h16M14 19h10M17 13h7" fill="none" stroke="white" stroke-width="2.4"></path>
        </svg>
        <span>Axelyn <strong>Forge</strong></span>
      </a>
      <nav aria-label="Workspace navigation">
        <a aria-current="page" href="/app">Resumes</a>
        <a href="/app/forge">Evidence brief</a>
        <UserButton />
      </nav>
    </header>

    <main class="library-shell">
      <section class="library-intro">
        <div>
          <p class="library-kicker"><span></span> Private workspace</p>
          <h1>Your resume<br /><em>source library.</em></h1>
        </div>
        <div class="intro-copy">
          <p>Keep one trusted source for every direction you pursue. Import an existing resume, review what Forge found, then shape it through the Axelyn standard.</p>
          <div class="privacy-note">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 10V7a5 5 0 0 1 10 0v3m-11 0h12v10H6z" /></svg>
            <span><strong>Private by default.</strong> Only your signed-in account can read these files.</span>
          </div>
        </div>
      </section>

      <section class="library-grid">
        <div class="library-primary">
          <div class="section-heading">
            <div><span>01</span><h2>Resume sources</h2></div>
            <p id="source-count">Loading your library…</p>
          </div>

          <form class="upload-panel" id="resume-upload-form">
            <label class="drop-zone" id="resume-drop-zone" for="resume-files">
              <input id="resume-files" name="files" type="file" accept=".docx,.pdf" multiple required />
              <span class="upload-mark" aria-hidden="true">+</span>
              <span class="upload-copy">
                <strong>Bring in your resume files</strong>
                <small>Drop up to 5 DOCX or PDF files here, or choose files · 10 MB each</small>
              </span>
              <span class="choose-files">Choose files</span>
            </label>
            <div class="upload-options">
              <label>
                <span>Shared target role <small>optional</small></span>
                <input name="target_role" type="text" maxlength="160" placeholder="e.g. Frontend Engineer" />
              </label>
              <button class="primary-button" type="submit">Import resumes <span aria-hidden="true">→</span></button>
            </div>
            <div class="file-selection" id="file-selection" hidden></div>
            <p class="form-status" id="upload-status" aria-live="polite"></p>
          </form>

          <div class="source-list" id="resume-source-list" aria-live="polite"></div>
        </div>

        <aside class="standard-panel">
          <p class="panel-index">The standard / v1</p>
          <div class="template-sheet" aria-hidden="true">
            <span></span><i></i><i></i><b></b><i></i><i></i><b></b><i></i><i></i>
          </div>
          <h2>One clean structure.<br />Every career direction.</h2>
          <p>Your uploaded resume supplies the facts. The Axelyn standard supplies the hierarchy and spacing, with editable DOCX and layout-stable PDF output.</p>
          <ul>
            <li><span>01</span> Import the source</li>
            <li><span>02</span> Review extracted facts</li>
            <li><span>03</span> Name the role version</li>
            <li><span>04</span> Generate DOCX + PDF</li>
          </ul>
        </aside>
      </section>

      <section class="variant-section">
        <div class="section-heading inverse">
          <div><span>02</span><h2>Ready to forge</h2></div>
          <p>Approved resume versions</p>
        </div>
        <div class="variant-list" id="resume-variant-list"></div>
      </section>
    </main>

    <dialog class="review-dialog" id="resume-review-dialog">
      <form method="dialog" class="dialog-close-form"><button aria-label="Close resume review">×</button></form>
      <div class="review-heading">
        <p><span></span> Review import</p>
        <h2>Confirm the facts before they enter your library.</h2>
        <p>Extraction can miss layout details. Edit anything that needs correction; Forge will only render what you approve here.</p>
      </div>
      <form class="review-form" id="resume-review-form">
        <input name="source_id" type="hidden" />
        <div class="review-fields two-up">
          <label><span>Library name</span><input name="display_name" maxlength="160" required /></label>
          <label><span>Target role</span><input name="target_role" maxlength="160" /></label>
          <label><span>Full name</span><input name="full_name" maxlength="160" /></label>
          <label><span>Professional headline</span><input name="headline" maxlength="200" /></label>
        </div>
        <label><span>Contact line</span><input name="contact_line" maxlength="300" /></label>
        <label><span>Professional summary</span><textarea name="summary" rows="5" maxlength="2000"></textarea></label>
        <label>
          <span>Extracted resume text <small>Used to map experience, projects, education, and skills</small></span>
          <textarea name="extracted_text" rows="16" maxlength="100000" required></textarea>
        </label>
        <label class="variant-name"><span>Version name</span><input name="variant_name" maxlength="160" placeholder="e.g. Frontend Engineer — Master" required /></label>
        <p class="form-status" id="review-status" aria-live="polite"></p>
        <div class="review-actions">
          <button class="secondary-button" id="save-draft" type="button">Save review</button>
          <button class="primary-button" type="submit">Approve version <span aria-hidden="true">→</span></button>
        </div>
      </form>
    </dialog>

    <template id="empty-sources-template">
      <div class="empty-library">
        <span>00</span>
        <div><strong>No resume sources yet.</strong><p>Your first imported file will appear here for review.</p></div>
      </div>
    </template>

    <footer class="library-footer">
      <span>Axelyn Forge / private document system</span>
      <a href="/">Return to axelyn.com</a>
    </footer>
  </div>
  <script is:inline src="/scripts/library.js" defer></script>
</BaseLayout>
