---
import AppSidebar from "../components/AppSidebar.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/resume-library.css";

const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? "";
const { isAuthenticated, redirectToSignIn } = Astro.locals.auth();

if (!isAuthenticated) {
  return redirectToSignIn();
}
---

<BaseLayout
  title="Resume library — Axelyn Forge"
  description="Create or import private resume versions, edit every section, and generate ATS-friendly DOCX and PDF files."
>
  <div class="library-page" data-api-base={apiBase} data-workspace-shell>
    <AppSidebar active="resumes" />

    <main class="library-shell">
      <section class="library-intro">
        <div>
          <p class="library-kicker"><span></span> Private workspace</p>
          <h1>Your resume<br /><em>source library.</em></h1>
        </div>
        <div class="intro-copy">
          <p>Start from a guided form or bring an existing PDF or Word file. Forge uses AI to structure the source into editable fields while keeping every file private and ready for the Axelyn standard layout.</p>
          <div class="privacy-note">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 10V7a5 5 0 0 1 10 0v3m-11 0h12v10H6z" /></svg>
            <span><strong>Private by default.</strong> Only your signed-in account can read these files.</span>
          </div>
        </div>
      </section>

      <section class="library-grid">
        <div class="library-primary">
          <div class="section-heading">
            <div><span>01</span><h2>Resume sources</h2></div>
            <div class="source-heading-actions">
              <p id="source-count">Loading your library…</p>
              <a href="/app/resume">Create from form <span aria-hidden="true">→</span></a>
            </div>
          </div>

          <section class="upload-panel" aria-label="Import resume files">
            <label class="drop-zone" id="resume-drop-zone" for="resume-files">
              <input id="resume-files" type="file" accept=".docx,.pdf" multiple />
              <span class="upload-mark" aria-hidden="true">+</span>
              <span class="upload-copy">
                <strong>Bring in your resume files</strong>
                <small>Drop up to 5 DOCX or PDF files here · AI structures the content, then Forge creates normalized Word, a standard template, JSON, and JSON Schema · 10 MB each</small>
              </span>
              <span class="choose-files">Choose files</span>
            </label>
            <div class="file-queue" id="file-queue" hidden></div>
            <p class="form-status" id="upload-status" aria-live="polite"></p>
          </section>

          <div class="source-list" id="resume-source-list" aria-live="polite"></div>
        </div>

      </section>

      <section class="variant-section">
        <div class="section-heading inverse">
          <div><span>02</span><h2>Ready to forge</h2></div>
          <p>Approved resume versions</p>
        </div>
        <div class="variant-list" id="resume-variant-list"></div>
      </section>
    </main>

    <template id="empty-sources-template">
      <div class="empty-library">
        <span>00</span>
        <div><strong>No resume sources yet.</strong><p>Create one from the guided form or import your first PDF or Word file.</p></div>
      </div>
    </template>

    <template id="upload-file-template">
      <article class="upload-file" data-state="queued">
        <div class="upload-file-identity">
          <span class="upload-file-type"></span>
          <div class="upload-file-copy">
            <strong></strong>
            <small class="upload-file-state">Ready to import</small>
          </div>
        </div>
        <div class="upload-file-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          <span class="upload-progress-track"><span class="upload-progress-fill"></span></span>
          <span class="upload-progress-value">0%</span>
        </div>
        <button class="upload-file-action" type="button" data-action="import-file">
          <span class="upload-action-label">Import</span>
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h13m-5-5 5 5-5 5" /></svg>
        </button>
      </article>
    </template>

    <footer class="library-footer">
      <span>Axelyn Forge / private document system</span>
      <a href="/">Return to axelyn.com</a>
    </footer>
  </div>
  <script>
    import "../scripts/library.js";
  </script>
</BaseLayout>
