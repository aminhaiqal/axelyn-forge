---
import AppSidebar from "../../components/AppSidebar.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/resume-builder.css";

const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? "";
const { isAuthenticated, redirectToSignIn } = Astro.locals.auth();

if (!isAuthenticated) {
  return redirectToSignIn();
}
---

<BaseLayout
  title="Resume builder — Axelyn Forge"
  description="Create or update a private resume and render it with a single-column ATS-friendly template."
>
  <div class="builder-page" data-workspace-shell data-api-base={apiBase}>
    <AppSidebar active="resumes" />

    <main class="builder-main">
      <header class="builder-header">
        <div>
          <a href="/app" class="builder-back">← Resume library</a>
          <p class="builder-kicker"><span></span> Guided resume builder</p>
          <h1 id="builder-title">Create your<br /><em>first resume.</em></h1>
        </div>
        <div class="builder-intro">
          <p>Enter the facts once, keep uncommon sections, and switch layouts without rebuilding your content.</p>
          <div><span>ATS-safe</span><span>Single column</span><span>Word + PDF</span></div>
        </div>
      </header>

      <form class="resume-builder-form" id="resume-builder-form">
        <textarea name="extracted_text" hidden></textarea>

        <section class="source-inbox" id="source-inbox" hidden>
          <div>
            <p>Imported source inbox</p>
            <h2>Nothing gets silently dropped.</h2>
            <p>These lines were present in the uploaded resume but did not map cleanly to a standard field. Keep them as a custom section, then rename or reorganize them.</p>
          </div>
          <pre id="unmapped-content"></pre>
          <button type="button" id="keep-unmapped">Keep as custom section <span>→</span></button>
        </section>

        <section class="builder-section">
          <div class="builder-section-heading"><span>01</span><div><h2>Identity</h2><p>Your name, contact details, professional direction, and document settings.</p></div></div>
          <div class="builder-fields two-up">
            <label><span>Full name</span><input name="full_name" maxlength="160" autocomplete="name" placeholder="Your full name" required /></label>
            <label><span>Professional headline</span><input name="headline" maxlength="200" placeholder="Software engineer focused on accessible products" /></label>
          </div>
          <label><span>Contact line</span><input name="contact_line" maxlength="300" placeholder="email@example.com | +60 … | Kuala Lumpur | linkedin.com/in/…" /></label>
          <label><span>Professional summary</span><textarea name="summary" rows="5" maxlength="2000" placeholder="Write 2–4 concise sentences about your experience, strengths, and direction."></textarea></label>

          <div class="builder-subsection">
            <div class="builder-subsection-heading">
              <h3>Resume settings</h3>
              <p>Name this source for your private library, set its target role, and choose the ATS-friendly layout.</p>
            </div>
            <div class="builder-fields two-up">
              <label><span>Library name</span><input name="display_name" maxlength="160" placeholder="My software engineering resume" required /></label>
              <label><span>Target role <small>optional</small></span><input name="target_role" maxlength="160" placeholder="Frontend Engineer" /></label>
            </div>
            <p class="builder-field-label">ATS-friendly template</p>
            <div class="template-options">
              <label class="template-option">
                <input type="radio" name="template_id" value="ats-classic" checked />
                <span class="template-preview classic"><i></i><b></b><b></b><em></em><b></b><b></b></span>
                <span><strong>Classic ATS</strong><small>Comfortable spacing · centered identity</small></span>
              </label>
              <label class="template-option">
                <input type="radio" name="template_id" value="ats-modern" />
                <span class="template-preview modern"><i></i><b></b><b></b><em></em><b></b><b></b></span>
                <span><strong>Modern ATS</strong><small>Balanced spacing · restrained color</small></span>
              </label>
              <label class="template-option">
                <input type="radio" name="template_id" value="ats-compact" />
                <span class="template-preview compact"><i></i><b></b><b></b><em></em><b></b><b></b></span>
                <span><strong>Compact ATS</strong><small>Tighter spacing · more content per page</small></span>
              </label>
            </div>
          </div>
        </section>

        <section class="builder-section">
          <div class="builder-section-heading builder-action-heading"><span>02</span><div><h2>Educational background</h2><p>Add each qualification separately. The essential details stay visible, while academic highlights remain optional.</p></div><button type="button" id="add-education">+ Add education</button></div>
          <div class="education-list" id="education-list"></div>
          <p class="education-empty" id="education-empty">No education added yet. Add a qualification when you are ready.</p>
          <div class="legacy-education" id="legacy-education" hidden>
            <div>
              <strong>Preserved imported education</strong>
              <p>This text came from an older or uploaded resume. Keep it here, or move it into structured entries above and clear it when finished.</p>
            </div>
            <label><span>Imported education text</span><textarea name="section_education" rows="9" maxlength="12000"></textarea></label>
          </div>
        </section>

        <section class="builder-section">
          <div class="builder-section-heading builder-action-heading"><span>03</span><div><h2>Work experience</h2><p>Add one entry for each role so every position stays separately editable in the generated resume.</p></div><button type="button" id="add-work-experience">+ Add work experience</button></div>
          <div class="work-experience-list" id="work-experience-list"></div>
          <p class="work-experience-empty" id="work-experience-empty">No work experience added yet. Add a role when you are ready.</p>
          <div class="legacy-experience" id="legacy-experience" hidden>
            <div>
              <strong>Preserved imported work content</strong>
              <p>This text came from an older or uploaded resume. Keep it here, or move it into structured entries above and clear it when finished.</p>
            </div>
            <label><span>Imported experience text</span><textarea name="section_experience" rows="10" maxlength="30000"></textarea></label>
          </div>
        </section>

        <section class="builder-section">
          <div class="builder-section-heading builder-action-heading"><span>04</span><div><h2>Projects</h2><p>Add each project separately so Forge can distinguish the product, your contribution, the technology, and its impact.</p></div><button type="button" id="add-project">+ Add project</button></div>
          <div class="project-list" id="project-list"></div>
          <p class="project-empty" id="project-empty">No projects added yet. Add a project when you are ready.</p>
          <div class="legacy-projects" id="legacy-projects" hidden>
            <div>
              <strong>Preserved imported projects</strong>
              <p>This text came from an older or uploaded resume. Keep it here, or move it into structured entries above and clear it when finished.</p>
            </div>
            <label><span>Imported project text</span><textarea name="section_projects" rows="10" maxlength="30000"></textarea></label>
          </div>
        </section>

        <section class="builder-section">
          <div class="builder-section-heading builder-action-heading"><span>05</span><div><h2>Skills</h2><p>Group related capabilities into simple categories that recruiters and ATS tools can scan quickly.</p></div><button type="button" id="add-skill-category">+ Add another category</button></div>
          <div class="skill-category-list" id="skill-category-list"></div>
          <p class="skill-category-empty" id="skill-category-empty">No skill categories added yet. Add a category when you are ready.</p>
          <div class="legacy-skills" id="legacy-skills" hidden>
            <div>
              <strong>Preserved imported skills</strong>
              <p>This text came from an older or uploaded resume. Keep it here, or move it into structured categories above and clear it when finished.</p>
            </div>
            <label><span>Imported skill text</span><textarea name="section_skills" rows="8" maxlength="12000"></textarea></label>
          </div>
        </section>

        <section class="builder-section custom-section-area">
          <div class="builder-section-heading custom-heading"><span>06</span><div><h2>Custom sections</h2><p>Finish with any content that does not fit above, such as languages, certifications, awards, volunteering, publications, or clearances.</p></div><button type="button" id="add-custom-section">+ Add section</button></div>
          <div class="custom-section-list" id="custom-section-list"></div>
          <p class="custom-empty" id="custom-section-empty">No custom sections yet. Add one when your background needs another heading.</p>
        </section>

        <section class="builder-finish">
          <div>
            <p>Ready / Finish</p>
            <h2>Save the source or create finished files.</h2>
            <label><span>Version name <small>needed when generating files</small></span><input name="variant_name" maxlength="160" placeholder="Frontend Engineer — Master" /></label>
            <p class="builder-status" id="builder-status" role="status" aria-live="polite">Your work remains private to your signed-in account.</p>
          </div>
          <div class="builder-actions">
            <button class="builder-secondary" id="save-resume-draft" type="button">Save draft</button>
            <button class="builder-primary" type="submit">Approve and generate <span>→</span></button>
          </div>
          <div class="builder-downloads" id="builder-downloads" hidden></div>
        </section>

        <details class="source-transcript" id="source-transcript" hidden>
          <summary>View the preserved import transcript</summary>
          <p>This read-only source remains available while you organize the editable fields above.</p>
          <pre id="source-transcript-content"></pre>
        </details>
      </form>
    </main>

    <template id="custom-section-template">
      <article class="custom-section-card">
        <div><span>Custom section</span><button type="button" data-remove-custom>Remove</button></div>
        <label><span>Section title</span><input data-custom-title maxlength="80" placeholder="e.g. Certifications" required /></label>
        <label><span>Content</span><textarea data-custom-lines rows="6" maxlength="20000" placeholder="Keep one item or bullet on each line."></textarea></label>
      </article>
    </template>

    <template id="education-template">
      <article class="education-card">
        <div class="education-card-head">
          <div><span>Educational background</span><strong data-education-entry-number>Entry 01</strong></div>
          <button type="button" data-remove-education>Remove</button>
        </div>
        <div class="education-fields">
          <label><span>Institution / University Name*</span><input data-education-field="institution_name" maxlength="200" placeholder="Universiti Teknologi Malaysia" required /></label>
          <label><span>Degree / Qualification*</span><input data-education-field="qualification" maxlength="200" placeholder="Bachelor of Computer Science" required /></label>
          <label><span>Field of Study / Major*</span><input data-education-field="field_of_study" maxlength="200" placeholder="Software Engineering" required /></label>
          <label><span>Education Level</span><select data-education-field="education_level"><option>Secondary School</option><option>Diploma</option><option>Foundation</option><option selected>Bachelor’s Degree</option><option>Master’s Degree</option><option>Doctorate / PhD</option><option>Professional Qualification</option><option>Other</option></select></label>
          <label><span>Location</span><input data-education-field="location" maxlength="160" placeholder="City, State, Country" /></label>
          <label><span>Start Date*</span><input data-education-field="start_date" type="month" required /></label>
          <label data-education-end-date-field><span>Graduation / End Date*</span><input data-education-field="end_date" type="month" required /></label>
          <fieldset class="education-current-field">
            <legend>Currently studying here?</legend>
            <div class="education-choice-pair">
              <label><input type="radio" data-education-current value="yes" /><span>Yes</span></label>
              <label><input type="radio" data-education-current value="no" checked /><span>No</span></label>
            </div>
          </fieldset>
        </div>
        <details class="education-optional">
          <summary><span>Optional academic details</span><small>GPA, coursework, thesis, achievements, activities, and skills</small></summary>
          <div class="education-optional-fields">
            <label><span>GPA / CGPA</span><input data-education-field="gpa" maxlength="80" placeholder="3.72 / 4.00" /></label>
            <label><span>Honours / Classification</span><input data-education-field="honours" maxlength="160" placeholder="First Class Honours" /></label>
            <label class="education-field-wide"><span>Relevant Coursework</span><textarea data-education-field="relevant_coursework" rows="3" maxlength="2000" placeholder="Software Architecture, Database Systems, Machine Learning"></textarea></label>
            <label class="education-field-wide"><span>Final Year Project / Thesis Title</span><input data-education-field="thesis_title" maxlength="300" placeholder="Intelligent Regulatory Document Classification System" /></label>
            <label class="education-field-wide"><span>Project / Thesis Description</span><textarea data-education-field="thesis_description" rows="4" maxlength="4000" placeholder="Briefly describe what you built or researched."></textarea></label>
            <label class="education-field-wide"><span>Academic Achievements / Awards</span><textarea data-education-field="academic_achievements" rows="4" maxlength="4000" placeholder="Dean’s List, scholarships, competitions, or academic awards. Keep one item on each line."></textarea></label>
            <label class="education-field-wide"><span>Activities &amp; Societies</span><textarea data-education-field="activities" rows="3" maxlength="4000" placeholder="Clubs, associations, leadership positions, or student organisations."></textarea></label>
            <label class="education-field-wide"><span>Relevant Skills Learned</span><textarea data-education-field="relevant_skills" rows="3" maxlength="2000" placeholder="Optional skills gained through this qualification."></textarea></label>
          </div>
        </details>
      </article>
    </template>

    <template id="work-experience-template">
      <article class="work-experience-card">
        <div class="work-experience-card-head">
          <div><span>Work experience</span><strong data-work-entry-number>Entry 01</strong></div>
          <button type="button" data-remove-work-experience>Remove</button>
        </div>
        <div class="work-experience-fields">
          <label><span>Company / Organization Name</span><input data-work-field="company_name" maxlength="160" placeholder="Example Company" required /></label>
          <label><span>Job Title / Position</span><input data-work-field="job_title" maxlength="160" placeholder="Software Engineer" required /></label>
          <label><span>Employment Type</span><select data-work-field="employment_type" required><option>Full-time</option><option>Part-time</option><option>Contract</option><option>Freelance</option><option>Internship</option><option>Self-employed</option></select></label>
          <label><span>Location</span><input data-work-field="location" maxlength="160" placeholder="Kuala Lumpur, Malaysia" required /></label>
          <label><span>Work Arrangement</span><select data-work-field="work_arrangement" required><option>On-site</option><option>Hybrid</option><option>Remote</option></select></label>
          <label><span>Start Date</span><input data-work-field="start_date" type="month" required /></label>
          <label data-end-date-field><span>End Date</span><input data-work-field="end_date" type="month" required /></label>
          <fieldset class="work-current-field">
            <legend>Are you currently working here?</legend>
            <div class="work-choice-pair">
              <label><input type="radio" data-work-current value="yes" /><span>Yes</span></label>
              <label><input type="radio" data-work-current value="no" checked /><span>No</span></label>
            </div>
          </fieldset>
          <label class="work-field-wide"><span>Job Description / Responsibilities</span><textarea data-work-field="responsibilities" rows="5" maxlength="10000" placeholder="Describe your main responsibilities in this role."></textarea></label>
          <label class="work-field-wide"><span>Key Achievements</span><textarea data-work-field="achievements" rows="5" maxlength="10000" placeholder="What did you accomplish or improve during this role? Keep one achievement on each line."></textarea></label>
        </div>
      </article>
    </template>

    <template id="project-template">
      <article class="project-card">
        <div class="project-card-head">
          <div><span>Project</span><strong data-project-entry-number>Entry 01</strong></div>
          <button type="button" data-remove-project>Remove</button>
        </div>
        <div class="project-fields">
          <label><span>Project Name*</span><input data-project-field="project_name" maxlength="200" placeholder="Monitorscape" required /></label>
          <label><span>Project Type</span><select data-project-field="project_type"><option>Personal Project</option><option>Client Project</option><option>Commercial Product</option><option>Academic Project</option><option>Open Source</option><option>Research Project</option><option>Internal Company Project</option></select></label>
          <label><span>Your Role</span><input data-project-field="role" maxlength="160" placeholder="Software Engineer, Backend Developer, Project Lead" /></label>
          <label><span>Project Status</span><select data-project-field="project_status"><option>Live / Production</option><option selected>In Development</option><option>Prototype</option><option>Completed</option><option>Discontinued</option></select></label>
          <label><span>Start Date</span><input data-project-field="start_date" type="month" /></label>
          <label data-project-end-date-field><span>End Date</span><input data-project-field="end_date" type="month" /></label>
          <fieldset class="project-current-field project-field-wide">
            <legend>Currently working on this project?</legend>
            <div class="project-choice-pair">
              <label><input type="radio" data-project-current value="yes" /><span>Yes</span></label>
              <label><input type="radio" data-project-current value="no" checked /><span>No</span></label>
            </div>
          </fieldset>
        </div>
        <div class="project-story">
          <div class="project-story-heading">
            <span>Project story</span>
            <p>Focus on what you personally contributed and the change the project created.</p>
          </div>
          <div class="project-story-fields">
            <label><span>What problem does this project solve?</span><small>Briefly explain the problem or need behind the project.</small><textarea data-project-field="problem" rows="4" maxlength="4000"></textarea></label>
            <label><span>What does the project do?</span><small>Describe the product, system, application, or solution.</small><textarea data-project-field="description" rows="4" maxlength="4000"></textarea></label>
            <label><span>Who is it built for?</span><small>Customers, businesses, internal users, students, developers, etc.</small><textarea data-project-field="audience" rows="3" maxlength="2000"></textarea></label>
            <label><span>What did you personally work on?</span><small>Describe your own contribution, not only what the whole team built.</small><textarea data-project-field="personal_contribution" rows="4" maxlength="8000" placeholder="Designed the backend API, payment integration, and PostgreSQL database."></textarea></label>
            <label><span>What were your main responsibilities?</span><small>Architecture, frontend, backend, database, deployment, testing, integrations, etc.</small><textarea data-project-field="responsibilities" rows="4" maxlength="8000"></textarea></label>
            <label><span>What did you build or implement?</span><small>Authentication system, REST API, recommendation engine, payment workflow, etc.</small><textarea data-project-field="deliverables" rows="4" maxlength="8000"></textarea></label>
            <label><span>What technologies did you use?</span><small>Python, React, FastAPI, PostgreSQL, AWS, Docker, etc.</small><textarea data-project-field="technologies" rows="3" maxlength="4000"></textarea></label>
            <label><span>What was the result or impact?</span><small>Explain what improved because this project existed.</small><textarea data-project-field="impact" rows="4" maxlength="8000"></textarea></label>
            <label class="project-field-wide"><span>Do you have measurable results?</span><small>Examples: 5,000 users, 20 customers, 100K documents processed, 60% faster, RM20K revenue, or 99.9% uptime.</small><textarea data-project-field="metrics" rows="3" maxlength="4000"></textarea></label>
          </div>
        </div>
        <details class="project-optional">
          <summary><span>Links and additional context</span><small>Project URL, repository, and the most challenging part</small></summary>
          <div class="project-optional-fields">
            <label><span>Project URL <small>optional</small></span><input data-project-field="project_url" type="url" maxlength="500" placeholder="https://monitorscape.example" /></label>
            <label><span>GitHub / Repository URL <small>optional</small></span><input data-project-field="repository_url" type="url" maxlength="500" placeholder="https://github.com/username/project" /></label>
            <label class="project-field-wide"><span>What was the most challenging part of the project? <small>optional</small></span><textarea data-project-field="challenge" rows="4" maxlength="4000" placeholder="Describe the constraint, complexity, or technical challenge you worked through."></textarea></label>
          </div>
        </details>
      </article>
    </template>

    <template id="skill-category-template">
      <article class="skill-category-card">
        <div class="skill-category-card-head">
          <div><span>Skill category</span><strong data-skill-category-number>Category 01</strong></div>
          <button type="button" data-remove-skill-category>Remove</button>
        </div>
        <div class="skill-category-fields">
          <label><span>Skill Category *</span><input data-skill-category list="skill-category-suggestions" maxlength="80" placeholder="e.g. Framework" autocomplete="off" required /></label>
          <div class="skill-editor">
            <p>Skills *</p>
            <div class="skill-chips" data-skill-chips role="list"></div>
            <div class="skill-entry-row">
              <input data-skill-input maxlength="100" placeholder="Type a skill" aria-label="Skill" required />
              <button type="button" data-add-skill>+ Add skill</button>
            </div>
            <small>Press Enter or use commas to add several skills.</small>
          </div>
        </div>
      </article>
    </template>

    <datalist id="skill-category-suggestions">
      <option value="Framework"></option>
      <option value="Programming Language"></option>
      <option value="Database"></option>
      <option value="Cloud"></option>
      <option value="DevOps"></option>
      <option value="Frontend"></option>
      <option value="AI / ML"></option>
    </datalist>
  </div>
  <script>
    import "../../scripts/resume-builder.js";
  </script>
</BaseLayout>
