{
  "schemaVersion": "1.0.0",
  "bindings": {
    "profile.fullName": {
      "source": "document.profile.fullName"
    },
    "profile.headline": {
      "source": "document.profile.headline"
    },
    "profile.contactLine": {
      "sources": [
        "document.profile.contact.email",
        "document.profile.contact.phone",
        "document.profile.contact.location",
        {
          "source": "document.profile.contact.links",
          "select": {
            "type": "linkedin"
          },
          "path": "url",
          "stripPrefix": "https://"
        }
      ],
      "separator": " | "
    },
    "summary.text": {
      "source": "summary-1.text"
    },

    "experience.axelyn.role": {
      "source": "experience-axelyn.role"
    },
    "experience.axelyn.date": {
      "source": "experience-axelyn.date.display"
    },
    "experience.axelyn.meta": {
      "sources": [
        "experience-axelyn.organization",
        {
          "source": "experience-axelyn.employmentType",
          "required": false
        },
        {
          "source": "experience-axelyn.location",
          "required": false
        }
      ],
      "separator": " | "
    },
    "experience.axelyn.highlight.1": {
      "source": "axelyn-highlight-1.text"
    },
    "experience.axelyn.highlight.2": {
      "source": "axelyn-highlight-2.text"
