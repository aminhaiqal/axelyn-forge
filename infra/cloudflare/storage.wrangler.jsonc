{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "axelyn-forge-storage",
  "main": "storage-worker.js",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "PRIVATE_RESUMES",
      "bucket_name": "axelyn-forge-private"
    }
  ],
  "observability": {
    "enabled": true
  }
}
