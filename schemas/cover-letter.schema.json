{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axelyn.com/schemas/forge/cover-letter.schema.json",
  "title": "Axelyn Forge Cover Letter",
  "description": "Canonical semantic cover-letter schema used by Axelyn Forge.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "document"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "document": {
      "$ref": "#/$defs/document"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "locale",
        "candidate",
        "application",
        "paragraphs",
        "signature"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "const": "cover-letter"
        },
        "locale": {
          "type": "string",
          "minLength": 2
        },
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "application": {
          "$ref": "#/$defs/application"
        },
        "paragraphs": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/paragraph"
          }
        },
        "signature": {
          "$ref": "#/$defs/signature"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legalName",
        "email",
        "location"
      ],
      "properties": {
        "legalName": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "location": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "recipient",
        "companyName",
        "jobTitle",
        "subject",
        "salutation"
      ],
      "properties": {
        "date": {
          "type": "string",
          "minLength": 1
        },
        "recipient": {
          "type": "string",
          "minLength": 1
        },
        "companyName": {
          "type": [
            "string",
            "null"
          ]
        },
        "jobTitle": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "salutation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "text",
        "supportingEvidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "cover-opening",
            "cover-body-1",
            "cover-body-2",
            "cover-body-3",
            "cover-body-4",
            "cover-body-5",
            "cover-body-6",
            "cover-value-proposition",
            "cover-closing"
          ]
        },
        "purpose": {
          "type": "string",
          "enum": [
            "opening",
            "experience",
            "company-fit",
            "motivation",
            "value-proposition",
            "closing"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "supportingEvidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "responseId",
        "workflowId"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "const": "openai"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "responseId": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflowId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
